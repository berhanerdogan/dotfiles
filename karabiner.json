{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Globe opens Finder home",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "fn",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": { "shell_command": "open ~" },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Command+Print Screen to Command+Shift+5",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "print_screen",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "to": {
                                    "key_code": "5",
                                    "modifiers": ["left_command", "left_shift"]
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Control+Print Screen to Control+Command+Shift+4",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "print_screen",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": {
                                    "key_code": "4",
                                    "modifiers": ["left_control", "left_command", "left_shift"]
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Print Screen to Command+Shift+4",
                        "manipulators": [
                            {
                                "from": { "key_code": "print_screen" },
                                "to": {
                                    "key_code": "4",
                                    "modifiers": ["left_command", "left_shift"]
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Contorl+hjkl to Arrow Keys",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "mandatory": ["contorl"] }
                                },
                                "to": [{ "key_code": "left_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "j",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "down_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "k",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "up_arrow" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "l",
                                    "modifiers": { "mandatory": ["control"] }
                                },
                                "to": [{ "key_code": "right_arrow" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "product_id": 591,
                        "vendor_id": 1452
                    },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "left_command" },
                            "to": [{ "key_code": "left_option" }]
                        },
                        {
                            "from": { "key_code": "left_option" },
                            "to": [{ "key_code": "left_command" }]
                        },
                        {
                            "from": { "key_code": "right_option" },
                            "to": [{ "key_code": "right_command" }]
                        },
                        {
                            "from": { "key_code": "application" },
                            "to": [{ "key_code": "right_option" }]
                        }
                    ]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "key_code": "caps_lock" },
                    "to": [{ "key_code": "left_option" }]
                }
            ],
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}
